# PersonalVault Environment Configuration

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public API Key (found in Supabase Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Storage Bucket Name
VITE_STORAGE_BUCKET=vault-documents

# Application Title
VITE_APP_NAME=PersonalVault
